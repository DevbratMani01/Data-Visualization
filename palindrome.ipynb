   "source": [
    "def palindrome(s):\n",
    "    s = s.lower().replace(\"_\",\" \")\n",
    "    return s == s[::-1]\n",
    "\n",
    "print(palindrome(\"Madam\"))\n",
    "\n"
   ]
  }
